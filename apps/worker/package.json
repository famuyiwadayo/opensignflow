{
    "name": "@opensignflow/worker",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "dev": "nest start --watch",
        "build": "nest build",
        "start": "node dist/main.js",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
        "clean": "rm -rf dist coverage"
    },
    "dependencies": {
        "@opensignflow/config": "workspace:*",
        "@opensignflow/crypto": "workspace:*",
        "@opensignflow/database": "workspace:*",
        "@opensignflow/queue": "workspace:*",
        "@opensignflow/shared": "workspace:*",
        "@opensignflow/storage": "workspace:*",
        "@nestjs/common": "^11.1.28",
        "@nestjs/config": "^4.0.4",
        "@nestjs/core": "^11.1.28",
        "bullmq": "^5.81.2",
        "ioredis": "^5.11.1",
        "nodemailer": "^9.0.3",
        "pg": "^8.22.0",
        "reflect-metadata": "^0.2.2",
        "resend": "^6.18.0",
        "rxjs": "^7.8.2"
    },
    "devDependencies": {
        "@opensignflow/testkit": "workspace:*",
        "@nestjs/cli": "^11.0.24",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.1.1",
        "@types/nodemailer": "^8.0.1",
        "@types/pg": "^8.20.0",
        "cross-env": "^10.1.0",
        "eslint": "^10.8.0",
        "jest": "^30.4.2",
        "ts-jest": "^29.4.12",
        "typescript": "^6"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "moduleNameMapper": {
            "^@/(.*)$": "<rootDir>/$1"
        },
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    }
}