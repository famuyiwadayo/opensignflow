# Root example. App-specific examples live in apps/web/.env.example and apps/api/.env.example.
NODE_ENV=development

# Local service URLs used by Docker Compose
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# Application URLs
API_PORT=4000
WEB_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Database
DATABASE_URL=postgresql://opensignflow:opensignflow@localhost:5432/opensignflow?schema=public

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# Authentication
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Object storage (S3/MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=opensignflow-documents
S3_ACCESS_KEY_ID=opensignflow
S3_SECRET_ACCESS_KEY=opensignflow-secret
S3_FORCE_PATH_STYLE=true

# Transactional outbox encryption: base64 encoding of exactly 32 random bytes.
# Generate with: openssl rand -base64 32
OUTBOX_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
OUTBOX_ENCRYPTION_KEY_VERSION=1

# Email (Mailpit/Resend)
# Production: resend
# Development: mailpit
MAIL_PROVIDER=mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="OpenSignFlow <no-reply@localhost>"
# Required for production
RESEND_API_KEY=

# AI
AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=