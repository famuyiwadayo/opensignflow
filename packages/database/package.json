{
    "name": "@opensignflow/database",
    "private": true,
    "type": "commonjs",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "dev": "prisma generate && tsc --watch --preserveWatchOutput",
        "build": "prisma generate && tsc -p tsconfig.json",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
        "test": "echo 'No tests yet for @opensignflow/database'",
        "clean": "rm -rf dist src/generated",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev --name dev",
        "db:migrate:create": "prisma migrate dev --create-only",
        "db:deploy": "prisma migrate deploy",
        "db:reset": "prisma migrate reset --force",
        "db:status": "prisma migrate status",
        "db:push": "prisma db push",
        "db:studio": "prisma studio"
    },
    "dependencies": {
        "@opensignflow/config": "workspace:*",
        "@prisma/adapter-pg": "^7.9.1",
        "@prisma/client": "^7.9.1"
    },
    "devDependencies": {
        "@opensignflow/config": "workspace:*",
        "@types/node": "^26.1.2",
        "eslint": "^10.8.0",
        "prisma": "^7.9.1",
        "typescript": "^7.0.2"
    }
}