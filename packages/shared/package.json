    "test": "echo 'No tests yet for @opensignflow/shared'",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-config-next": "^16.2.11",
    "globals": "^17.7.0",
    "typescript-eslint": "^8.65.0"
  }
}